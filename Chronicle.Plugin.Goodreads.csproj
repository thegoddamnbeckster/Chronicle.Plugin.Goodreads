<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Chronicle.Plugin.Goodreads</AssemblyName>
    <RootNamespace>Chronicle.Plugin.Goodreads</RootNamespace>
    <Version>1.0.2</Version>
    <Description>Chronicle import plugin for Goodreads — RSS feeds and CSV export</Description>
  </PropertyGroup>

  <!-- Chronicle.Plugins.dll is provided by the host at runtime: do NOT copy it to the output. A project reference (not a
       HintPath to a built DLL) so this plugin is rebuilt whenever the plugin API changes; with a HintPath, MSBuild thinks
       an old build is up to date and the stale plugin fails at run time with "Method not found". -->
  <ItemGroup>
    <ProjectReference Include="..\Chronicle\src\Chronicle.Plugins\Chronicle.Plugins.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- RSS parsing via System.Xml (built-in); CSV parsing via CsvHelper -->
    <PackageReference Include="CsvHelper" Version="33.*" />
    <!--
      Serilog is loaded by the Chronicle host, not bundled here (ExcludeAssets=runtime).
      Pinned to the EXACT version Chronicle.API itself references, matching the convention
      Chronicle.Plugin.Simkl's csproj documents: a floating range can resolve to a newer patch
      than what the host has loaded, and a version mismatch throws FileNotFoundException at
      runtime the moment the plugin touches logging. Bump this only when Chronicle.API's own
      Serilog version changes.
    -->
    <PackageReference Include="Serilog" Version="4.3.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
